{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode"],
  "properties": {
    "mode": {"type": "string", "enum": ["profile", "compare", "lookup", "reports", "order_report"]},
    "company": {"type": "string", "minLength": 2, "maxLength": 200},
    "companies": {"type": "string", "minLength": 3, "maxLength": 1100},
    "country": {"type": "string", "pattern": "^[A-Za-z]{2}$"},
    "objective": {"type": "string", "maxLength": 500},
    "window_days": {"type": "string", "enum": ["30", "90", "365"], "default": "90"},
    "allow_paid": {"type": "string", "enum": ["false", "true"], "default": "false"},
    "include_people": {"type": "string", "enum": ["false", "true"], "default": "false"},
    "output_mode": {"type": "string", "enum": ["chat", "markdown", "html"]},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$", "maxLength": 16}
  }
}
