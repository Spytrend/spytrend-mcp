{
  "version": "1.0.0",
  "contract": "contract.md",
  "skills": [
    {
      "name": "spytrend-vertical-intel",
      "prompt": "spytrend_vertical_intel",
      "title": "Vertical intelligence",
      "description": "Map one advertising vertical and market using server-ranked advertisers, networks, creative reuse and launch signals.",
      "input_schema": "schemas/vertical-intel.input.json",
      "tools": [
        {"name": "get_usage", "response_fields": ["remaining"]},
        {"name": "get_trends", "params": ["dimension", "ai_category", "country", "min_geo_share", "sort_by", "limit"], "response_fields": ["data", "meta.dimension_semantics", "total_status"]},
        {"name": "search_webmasters", "params": ["ai_category", "countries", "min_geo_share", "sort_by", "limit"], "response_fields": ["pagination.total", "pagination.total_status"]},
        {"name": "search_creatives", "params": ["categories", "countries", "sort_by", "period_from", "period_to", "limit"], "response_fields": ["data.total_ads", "data.ads_in_period", "pagination.period_axis"]},
        {"name": "get_media", "params": ["entity_type", "ids"], "response_fields": ["items", "failures"]}
      ],
      "arguments": [
        {"name": "vertical", "title": "Vertical", "description": "Advertising vertical or category.", "required": true, "max_length": 100},
        {"name": "country", "title": "Country", "description": "Optional ISO-2 country code.", "max_length": 2},
        {"name": "period_from", "title": "Period start", "description": "Inclusive YYYY-MM-DD start date.", "max_length": 10},
        {"name": "period_to", "title": "Period end", "description": "Inclusive YYYY-MM-DD end date.", "max_length": 10},
        {"name": "depth", "title": "Depth", "description": "Report depth.", "allowed": ["lean", "standard", "deep"]},
        {"name": "output_mode", "title": "Output", "description": "Preferred output mode.", "allowed": ["chat", "markdown", "html"]},
        {"name": "language", "title": "Language", "description": "BCP-47 output language; defaults to the user's language.", "max_length": 16},
        {"name": "include_media", "title": "Media", "description": "Whether confirmed media retrieval is allowed.", "allowed": ["false", "true"]}
      ]
    },
    {
      "name": "spytrend-advertiser-overview",
      "prompt": "spytrend_advertiser_overview",
      "title": "Advertiser overview",
      "description": "Rank advertiser pages in a selected market and profile their current winners, fresh ads and destination coverage.",
      "input_schema": "schemas/advertiser-overview.input.json",
      "tools": [
        {"name": "get_usage", "response_fields": ["remaining"]},
        {"name": "get_trends", "params": ["dimension", "ai_category", "country", "min_geo_share", "sort_by", "limit"], "response_fields": ["data.launched_14d", "data.filter_match.exact_active", "data.filter_match.exact_available"]},
        {"name": "search_creatives", "params": ["fanpages", "categories", "sort_by", "limit"], "response_fields": ["data.total_ads", "data.active_ads_today", "pagination.sort_semantics"]},
        {"name": "search_ads", "params": ["page_id", "categories", "countries", "status_today", "sort_by", "dedupe", "limit"], "response_fields": ["data.first_seen_date", "data.start_date", "pagination.total_status"]},
        {"name": "get_advertiser", "params": ["id"], "response_fields": ["card_status", "total_ads", "active_ads", "ai_coverage"]},
        {"name": "get_media", "params": ["entity_type", "ids"], "response_fields": ["items", "failures"]}
      ],
      "arguments": [
        {"name": "vertical", "title": "Vertical", "description": "Advertising vertical or category.", "required": true, "max_length": 100},
        {"name": "country", "title": "Country", "description": "ISO-2 country code.", "required": true, "max_length": 2},
        {"name": "limit", "title": "Profiles", "description": "Maximum advertiser profiles to inspect.", "allowed": ["3", "5", "10"]},
        {"name": "output_mode", "title": "Output", "description": "Preferred output mode.", "allowed": ["chat", "markdown", "html"]},
        {"name": "language", "title": "Language", "description": "BCP-47 output language; defaults to the user's language.", "max_length": 16},
        {"name": "include_media", "title": "Media", "description": "Whether confirmed media retrieval is allowed.", "allowed": ["false", "true"]}
      ]
    },
    {
      "name": "spytrend-webmaster-overview",
      "prompt": "spytrend_webmaster_overview",
      "title": "Advertising network overview",
      "description": "Profile the advertising network behind a domain or network result, including identifiers, geographies and reused creatives.",
      "input_schema": "schemas/webmaster-overview.input.json",
      "tools": [
        {"name": "get_usage", "response_fields": ["remaining"]},
        {"name": "search_webmasters", "params": ["domain", "query", "limit"], "response_fields": ["pagination.total", "pagination.total_status"]},
        {"name": "get_webmaster", "params": ["id"], "response_fields": ["analytics_pending", "fanpages_status", "top_creatives", "attribution_link_stats"]},
        {"name": "search_creatives", "params": ["webmaster_id", "categories", "sort_by", "limit"], "response_fields": ["data.total_ads", "pagination.sort_semantics"]},
        {"name": "search_ads", "params": ["webmaster_id", "categories", "countries", "country_match", "status_today", "sort_by", "dedupe", "limit"], "response_fields": ["data.first_seen_date", "data.start_date", "analysis.date_basis"]},
        {"name": "get_media", "params": ["entity_type", "ids"], "response_fields": ["items", "failures"]}
      ],
      "arguments": [
        {"name": "network", "title": "Network", "description": "Network name, canonical id or landing domain.", "required": true, "max_length": 200},
        {"name": "vertical", "title": "Vertical", "description": "Optional advertising vertical.", "max_length": 100},
        {"name": "country", "title": "Country", "description": "Optional ISO-2 country code.", "max_length": 2},
        {"name": "output_mode", "title": "Output", "description": "Preferred output mode.", "allowed": ["chat", "markdown", "html"]},
        {"name": "language", "title": "Language", "description": "BCP-47 output language; defaults to the user's language.", "max_length": 16},
        {"name": "include_media", "title": "Media", "description": "Whether confirmed media retrieval is allowed.", "allowed": ["false", "true"]}
      ]
    },
    {
      "name": "spytrend-website-review",
      "prompt": "spytrend_website_review",
      "title": "Website advertising review",
      "description": "Review one website's traffic snapshot, advertising footprint, advertiser pages and leading creative material.",
      "input_schema": "schemas/website-review.input.json",
      "tools": [
        {"name": "get_usage", "response_fields": ["remaining"]},
        {"name": "search_shops", "params": ["q", "country", "limit"], "response_fields": ["data.domain", "data.traffic_as_of", "data.ads_monthly"]},
        {"name": "get_shop", "params": ["domain"], "response_fields": ["domain", "traffic_as_of", "ads_monthly", "total_ads"]},
        {"name": "search_webmasters", "params": ["domain", "countries", "limit"]},
        {"name": "get_advertiser", "params": ["id"], "response_fields": ["card_status", "total_ads", "active_ads"]},
        {"name": "search_ads", "params": ["landing_domain", "landing_domain_exact", "country", "date_from", "date_to", "sort_by", "limit"], "response_fields": ["data.same_creative_ads_in_selection", "pagination.total", "pagination.total_status"]},
        {"name": "get_media", "params": ["entity_type", "ids"], "response_fields": ["items", "failures"]}
      ],
      "arguments": [
        {"name": "domain", "title": "Domain", "description": "Website domain without a path.", "required": true, "max_length": 253},
        {"name": "country", "title": "Country", "description": "Optional ISO-2 country code.", "max_length": 2},
        {"name": "period_from", "title": "Period start", "description": "Inclusive YYYY-MM-DD start date.", "max_length": 10},
        {"name": "period_to", "title": "Period end", "description": "Inclusive YYYY-MM-DD end date.", "max_length": 10},
        {"name": "output_mode", "title": "Output", "description": "Preferred output mode.", "allowed": ["chat", "markdown", "html"]},
        {"name": "language", "title": "Language", "description": "BCP-47 output language; defaults to the user's language.", "max_length": 16},
        {"name": "include_media", "title": "Media", "description": "Whether confirmed media retrieval is allowed.", "allowed": ["false", "true"]}
      ]
    },
    {
      "name": "spytrend-keyword-search",
      "prompt": "spytrend_keyword_search",
      "title": "Keyword advertising search",
      "description": "Analyze ads matching a keyword, with bounded market breakdowns and exact creative reuse inside the selected result set.",
      "input_schema": "schemas/keyword-search.input.json",
      "tools": [
        {"name": "get_usage", "response_fields": ["remaining"]},
        {"name": "search_ads", "params": ["query", "countries", "categories", "date_from", "date_to", "sort_by", "limit"], "response_fields": ["pagination.total", "pagination.total_status", "data.same_creative_ads_in_selection"]},
        {"name": "get_ads_analytics", "params": ["query", "countries", "categories", "date_from", "date_to", "max_items_per_section"], "response_fields": ["pending", "total", "total_status", "sections_ready", "countries.available_count", "countries.returned_count", "countries.truncated"]},
        {"name": "get_media", "params": ["entity_type", "ids"], "response_fields": ["items", "failures"]}
      ],
      "arguments": [
        {"name": "keyword", "title": "Keyword", "description": "Keyword or short phrase to search.", "required": true, "max_length": 120},
        {"name": "country", "title": "Country", "description": "Optional ISO-2 country code.", "max_length": 2},
        {"name": "vertical", "title": "Vertical", "description": "Optional advertising vertical.", "max_length": 100},
        {"name": "period_from", "title": "Period start", "description": "Inclusive YYYY-MM-DD start date.", "max_length": 10},
        {"name": "period_to", "title": "Period end", "description": "Inclusive YYYY-MM-DD end date.", "max_length": 10},
        {"name": "output_mode", "title": "Output", "description": "Preferred output mode.", "allowed": ["chat", "markdown", "html"]},
        {"name": "language", "title": "Language", "description": "BCP-47 output language; defaults to the user's language.", "max_length": 16},
        {"name": "include_media", "title": "Media", "description": "Whether confirmed media retrieval is allowed.", "allowed": ["false", "true"]}
      ]
    },
    {
      "name": "spytrend-shop-discovery",
      "prompt": "spytrend_shop_discovery",
      "title": "Shop discovery",
      "description": "Discover store domains by traffic, growth and advertising activity, then inspect a bounded set of leading stores.",
      "input_schema": "schemas/shop-discovery.input.json",
      "tools": [
        {"name": "get_usage", "response_fields": ["remaining"]},
        {"name": "search_shops", "params": ["ai_category", "country", "platform", "sort_by", "exclude_infrastructure", "offset", "limit"], "response_fields": ["data.domain", "data.traffic_as_of", "data.ads_monthly", "total", "has_more"]},
        {"name": "search_ads", "params": ["landing_domain", "landing_domain_exact", "date_from", "date_to", "sort_by", "limit"], "response_fields": ["data.same_creative_ads_in_selection", "pagination.total", "pagination.total_status"]},
        {"name": "get_advertiser", "params": ["id"], "response_fields": ["card_status", "total_ads", "active_ads"]},
        {"name": "search_webmasters", "params": ["domain", "limit"], "response_fields": ["pagination.total", "pagination.total_status"]},
        {"name": "get_media", "params": ["entity_type", "ids"], "response_fields": ["items", "failures"]}
      ],
      "arguments": [
        {"name": "vertical", "title": "Vertical", "description": "Optional advertising vertical.", "max_length": 100},
        {"name": "country", "title": "Country", "description": "Optional ISO-2 country code.", "max_length": 2},
        {"name": "platform", "title": "Platform", "description": "Store platform or any.", "max_length": 80},
        {"name": "output_mode", "title": "Output", "description": "Preferred output mode.", "allowed": ["chat", "markdown", "html"]},
        {"name": "language", "title": "Language", "description": "BCP-47 output language; defaults to the user's language.", "max_length": 16},
        {"name": "include_media", "title": "Media", "description": "Whether confirmed media retrieval is allowed.", "allowed": ["false", "true"]}
      ]
    }
  ]
}
